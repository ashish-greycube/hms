  "font": "Default",
  "format_data": null,
  "html": "<style>\n\t.print-format table, .print-format tr, \n\t.print-format td, .print-format div, .print-format p {\n\t\tfont-family: Monospace;\n\t\tline-height: 200%;\n\t\tvertical-align: middle;\n\t}\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 4in;\n\t\t\tpadding: 0.25in;\n\t\t\tmin-height: 8in;\n\t\t}\n\t}\n</style>\n\n<p class=\"text-center\">\n{{ frappe.get_doc(\"Letter Head\",{\"is_default\" : 1}).get(\"content\") }}\n</p>\n\n\n<table class=\"table table-condensed cart no-border\">\n<tbody>\n    <tr>\n        <td width=\"50%\">Emp: {{doc.owner}}</td>\n        <td width=\"50%\" style=\"text-align:right\">{{doc.name}}</td>\n    </tr>\n    <tr>\n        <td width=\"50%\">{{frappe.format_date(doc.posting_date,\"dd/MM/YYYY\")}}<br>\n        {{frappe.utils.format_datetime(doc.modified, \"HH:MM a\")}}</td>\n        <td width=\"50%\" style=\"text-align:right\">Table:<br>Guests:</td>\n    </tr>\n\n</tbody>\n</table>\n\n\n<table class=\"table table-condensed cart no-border\">\n\t<tbody>\n\t\t{%- for item in doc.items -%}\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t{{item.qty}} &nbsp; {{ item.item_code }}\n\t\t\t\t{%- if item.item_name != item.item_code -%}\n\t\t\t\t\t<br>{{ item.item_name }}{%- endif -%}\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n\n\n<table class=\"table table-condensed cart no-border\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"width:60%\"> Total Due:</td>\n\t\t\t<td style=\"width:40%;text-align:right\">\t{{ doc.get_formatted(\"rounded_total\") }}\t</td>\n\t\t</tr>\n        {% if doc.room_folio_cf %}\n        {% set room_no = frappe.db.get_value(\"Room Folio HMS\", doc.room_folio_cf, \"room_no\") %}\n        <tr>\n            <td> Bill to Room - {{room_no}}</td>\n            <td style=\"text-align:right\">-{{ doc.get_formatted(\"rounded_total\") }}</td>\n        </tr>\n        {% endif %}\n\t</tbody>\n</table>\n\n\n<p><strong>Signature</strong></p><br/>\n<p><strong>Print Name</strong></p>",
