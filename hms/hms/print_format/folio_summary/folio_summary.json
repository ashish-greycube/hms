 "doctype": "Print Format",
 "font": "Default",
 "html": "{%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead) -%}\n    {% if letter_head and not no_letterhead %}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n    {%- if doc.meta.is_submittable and doc.docstatus==2-%}\n    <div class=\"alert alert-danger text-center\">\n        <h4 style=\"margin: 0px;\">{{ _(\"CANCELLED\") }}</h4></div>\n    {%- endif -%}\n    {%- if doc.meta.is_submittable and doc.docstatus==0-%}\n    <div class=\"alert alert-danger text-center\">\n        <h4 style=\"margin: 0px;\">{{ _(\"DRAFT\") }}</h4></div>\n    {%- endif -%}\n\n    {% if max_pages > 1 %}\n    <p class=\"text-right\">{{ _(\"Page #{0} of {1}\").format(page_num, max_pages) }}</p>\n    {% endif %}\n{%- endmacro -%}\n{{ add_header(0,1,doc,letter_head, no_letterhead) }}\n{% set print_doc = doc.get_print_doc() %}\n\n{% block head_include %}\n<meta name=\"pdfkit-orientation\" content=\"portrait\" />\n{% endblock %}\n\n{% block content %}\n\n<div>\n    <p>{{ print_doc.company_description }}</p>\n</div>\n<div class=\"row\">\n    <div class=\"col col-sm-3\">\n        <strong> {{doc.customer.upper()}}</strong>\n    </div>\n    <div class=\"col col-sm-9\">\n        <table class='table table-bordered'>\n            <colgroup>\n                <col style=\"width: 10%;\">\n                <col style=\"width: 40%;\">\n                <col style=\"width: 20%;\">\n                <col style=\"width: 20%;\">\n                <col style=\"width: 10%;\">\n            </colgroup>\n            <thead>\n                <tr>\n                    <th>Room</th>\n                    <th>Folio</th>\n                    <th>Check In</th>\n                    <th>Check Out</th>\n                    <th>Balance</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for d in print_doc.get(\"folios\") %}\n                <tr>\n                    <td>{{ d.room_no }}</td>\n                    <td>{{ d.folio }}</td>\n                    <td>{{ frappe.utils.format_datetime(d.check_in,\"dd MMM, yyyy\") }}</td>\n                    <td>{{ frappe.utils.format_datetime(d.check_out,\"dd MMM, yyyy\") }}</td>\n                    <td class=\"text-right\">{{ d.balance }}</td>\n                </tr>\n                {% endfor %}\n                <tr>\n                    <td colspan=\"2\" class=\"text-right\">Master Folio</td>\n                    <td colspan=\"3\" class=\"text-right\">\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n</div>\n\n\n\n<div>\n    <table class=\"table table-bordered\">\n        <colgroup>\n            <col style=\"width:10%;\">\n            <col style=\"width:10%;\">\n            <col style=\"width:50%;\">\n            <col style=\"width:10%;\">\n            <col style=\"width:10%;\">\n            <col style=\"width:10%;\">\n        </colgroup>\n        <thead>\n            <tr>\n                <th>Date</th>\n                <th>Room</th>\n                <th>Description/Voucher</th>\n                <th>Charges</th>\n                <th>Credits</th>\n                <th>Balance</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for d in print_doc.get(\"items\") %}\n            <tr>\n                <td>{{ frappe.utils.format_datetime(d.date, \"dd/MM/yyyy\") }}</td>\n                <td>{{ d.room_no or \"\" }}</td>\n                <td>{{ d.voucher }}</td>\n                <td class=\"text-right\">{{ d.charges }}</td>\n                <td class=\"text-right\">{{ d.credits }}</td>\n                <td class=\"text-right\">{{ d.balance }}</td>\n            </tr>\n            {% endfor %}\n            <tr>\n                <td colspan=\"3\" class=\"text-right\"></td>\n                <td class=\"right\">{{ frappe.format((print_doc.get(\"items\") | sum(attribute=\"charges\")), {fieldtype: \"Currency\"}) }}</td>\n                <td class=\"right\">{{ frappe.format((print_doc.get(\"items\") | sum(attribute=\"credits\")), {fieldtype: \"Currency\"}) }}</td>\n                                <td class=\"right\"></td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n{% endblock %}\n<div>\n    <div id=\"footer-html\" class=\"visible-pdf\">\n        {% if not no_letterhead and footer %}\n        <div class=\"letter-head-footer\">\n            {{ footer }}\n        </div>\n        {% endif %}\n        <p class=\"text-center small page-number visible-pdf\">\n            {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n        </p>\n    </div>",
